# Dev-only: public HTTPS tunnel to your local backend (ngrok, cloudflared, etc.).
# Copy to dev-tunnel.env and set your current tunnel URL — backend PUBLIC_API_URL for Twilio webhooks.
# Frontend API stays at http://localhost:3001 (see frontend/.env.development). After URL changes: restart backend + npm run tunnel:sync
DEV_TUNNEL_URL=https://your-subdomain.ngrok-free.app

# Backend API URL (for auth and API calls). No trailing slash.
# - Local backend:  VITE_API_URL=http://localhost:3001  (see .env.development)
# - Production:     VITE_API_URL=https://staffing.wudox.ca  (default if unset)
VITE_API_URL=https://staffing.wudox.ca

# Google Maps API key — enables address autocomplete on the Employee form.
# Requires "Places API (New)" + "Maps JavaScript API" enabled on the key.
# Leave empty to fall back to a plain, manually-typed address field.
VITE_GOOGLE_MAPS_API_KEY=

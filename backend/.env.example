# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1
API_PREFIX=/api
# Max request body size for JSON/urlencoded (e.g. document uploads with base64). Default 20mb.
# BODY_LIMIT=20mb

# Database (Docker Compose maps Postgres to host port 5433 — see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/wudox_crm?schema=public

# Super Admin initial password (seed only, when SEED_ALL_SUPER_ADMIN=false).
# If unset, seed uses: Wudox-SuperAdmin-2025!
# SUPER_ADMIN_INITIAL_PASSWORD=your-secure-password

# Seed all demo users as super_admin (NOT recommended — breaks Super Users + approval demos). Default: persona roles + password123.
# SEED_ALL_SUPER_ADMIN=true

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h

# Redis (for caching and queues). Set REDIS_ENABLED=false to run without Redis
# Option A: Use a single URL (e.g. from Upstash, Redis Cloud) - recommended for hosted Redis
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
# Option B: Use host/port (e.g. local Redis)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@wudox.ca
EMAIL_FROM_NAME=Wudox CRM
# Inbound email replies (SendGrid Inbound Parse)
# Configure SendGrid Inbound Parse for this domain/subdomain and point it to:
#   https://<YOUR_API_HOST>/api/v1/emails/inbound
# If unset, replies will use the EMAIL_FROM domain (often NOT what you want).
# Recommended:
#   EMAIL_INBOUND_DOMAIN=inbound.yourdomain.com
#   EMAIL_INBOUND_LOCALPART=reply
# This makes Reply-To like: reply+crmreply-<emailId>.<userId>@inbound.yourdomain.com
# EMAIL_INBOUND_DOMAIN=inbound.yourdomain.com
# EMAIL_INBOUND_LOCALPART=reply

# Per-user sender identity (optional). When non-empty, associate-driven emails
# are sent with From: <associate-email> instead of EMAIL_FROM. Every listed
# domain MUST be authenticated in SendGrid (DKIM + SPF) or deliverability will
# suffer. Comma-separated. Leave empty to use the universal EMAIL_FROM everywhere.
# SEND_AS_ALLOWED_DOMAINS=hrglobal.com
# Dev/staging safety: redirect all per-user From addresses to this single
# inbox (useful for QA without hitting real associates' mailboxes).
# SEND_AS_OVERRIDE_EMAIL=qa-sink@example.com

# Twilio Voice — optional master account for import/provisioning; per-agency subaccount creds live in DB (Settings → Phone System → Integrations)
# Create a Standard API Key (Console → Account → API keys & tokens); copy the Secret ONCE into TWILIO_API_KEY_SECRET — never the Auth Token.
# TwiML App: Voice Request URL must POST to https://<API>/api/v1/voice/webhook/twiml
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Deprecated — one-time migration only; configure agency numbers in Settings → Phone System
# TWILIO_CALLER_ID=+1234567890
# Optional: regional account (e.g. ie1, au1, de1). Leave unset for default US.
# TWILIO_REGION=ie1

# At-rest encryption for Google refresh tokens and Twilio Auth Token / API Key Secret in DB.
# Required in production. Generate: openssl rand -hex 32
# GOOGLE_TOKEN_ENCRYPTION_KEY=

# Google Calendar OAuth (agency-wide connect in Settings)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
# Optional: restrict to Workspace domain
# GOOGLE_WORKSPACE_DOMAIN=

# Cloudflare R2 Storage (S3-compatible) — org default bucket for all agencies
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=wudox-crm-documents
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-public-bucket-url.r2.dev

# PandaDoc (optional — proposals + employee onboarding agreements)
PANDADOC_API_KEY=
PANDADOC_WEBHOOK_SECRET=

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,xlsx,csv

# IP-based restriction (optional). Comma-separated IPs and/or CIDRs. Empty = no restriction. /health always allowed.
# IP_ALLOWLIST=203.0.113.10,198.51.100.0/24
# TRUST_PROXY=true

# Logging
LOG_LEVEL=info

# CORS (include your frontend origin; Vite default dev is 5173, this project uses 8080)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Application URLs
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
# Public HTTPS origin Twilio hits — production: set here. Dev: use repo-root dev-tunnel.env (DEV_TUNNEL_URL) instead.
# PUBLIC_API_URL=https://api.yourdomain.com
# TRUST_PROXY=true

# Staff↔staff WebRTC (Messages) — JSON array of ICE servers. Unset = public STUN only.
# For production NAT, add self-hosted TURN (coturn), e.g.:
# INTERNAL_CALL_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
# INTERNAL_CALL_ICE_SERVERS=

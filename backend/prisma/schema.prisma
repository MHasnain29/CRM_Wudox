model RbacPermission {
  id          String                @id @default(uuid())
  key         String                @unique
  name        String
  description String?
  module      String?
  parentId    String?               @map("parent_id")
  sortOrder   Int                   @default(0) @map("sort_order")
  actionType  PermissionActionType? @map("action_type")
  isGroup     Boolean               @default(false) @map("is_group")
  isSystem    Boolean               @default(true) @map("is_system")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  parent      RbacPermission?       @relation("RbacPermissionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    RbacPermission[]      @relation("RbacPermissionTree")
  roles       RolePermission[]

  @@index([parentId])
  @@index([module])
  @@map("rbac_permissions")
}

model RolePermission {
  roleId       String         @map("role_id")
  permissionId String         @map("permission_id")
  role         RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}


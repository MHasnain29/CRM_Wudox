model UserActivitySession {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  subCompanyId   String              @map("sub_company_id")
  startedAt      DateTime            @default(now()) @map("started_at")
  endedAt        DateTime?           @map("ended_at")
  lastSeenAt     DateTime            @map("last_seen_at")
  currentState   ActivityState       @default(active) @map("current_state")
  idleStartedAt  DateTime?           @map("idle_started_at")
  activeSeconds  Int                 @default(0) @map("active_seconds")
  idleSeconds    Int                 @default(0) @map("idle_seconds")
  offlineSeconds Int                 @default(0) @map("offline_seconds")
  version        Int                 @default(0)
  user           User                @relation(fields: [userId], references: [id])
  events         UserActivityEvent[]

  @@index([userId, endedAt])
  @@index([subCompanyId, startedAt])
  @@index([lastSeenAt])
  @@index([currentState, lastSeenAt])

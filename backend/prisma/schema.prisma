  session    UserActivitySession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, eventAt])
  @@map("user_activity_events")
}

model Remark {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  authorId     String   @map("author_id")
  authorName   String   @map("author_name")
  authorRole   String   @map("author_role") @db.VarChar(64)
  subCompanyId String   @map("sub_company_id")
  content      String   @db.Text
  /// "only_me" | "public" | "shared"
  visibility   String   @db.VarChar(16)
  /// "agency" | "global" — only set when visibility = "public"
  scope        String?  @db.VarChar(16)
  /// User IDs — only set when visibility = "shared"
  sharedWith   String[] @default([]) @map("shared_with")
  isPinned     Boolean  @default(false) @map("is_pinned")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id])
  subCompany SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt(sort: Desc)])
  @@index([clientId, isPinned])
  @@index([authorId])
  @@index([visibility, scope, subCompanyId])
  @@map("remarks")
}

/// Audit trail for every employee offboarding commit.
model OffboardingLog {
  id              String     @id @default(uuid())
  departingUserId String     @map("departing_user_id")
  adminId         String     @map("admin_id")
  subCompanyId    String     @map("sub_company_id")
  /// Full commit payload for reproducibility.
  payload         Json
  /// High-level counts: { emailCount, clientCount, pipelineCount, leadCount, taskCount, meetingCount }.
  summary         Json
  committedAt     DateTime   @default(now()) @map("committed_at")

  departingUser   User       @relation("OffboardingDeparting", fields: [departingUserId], references: [id])
  admin           User       @relation("OffboardingAdmin", fields: [adminId], references: [id])
  subCompany      SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)

  @@index([departingUserId])
  @@index([adminId])
  @@index([subCompanyId])
  @@index([committedAt])
  @@map("offboarding_logs")
}


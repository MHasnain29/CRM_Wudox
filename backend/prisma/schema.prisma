  superUserClientDestination String     @default("agency") @map("super_user_client_destination")
  databaseImportAgencyId    String?     @map("database_import_agency_id")
  databaseImportAgency      SubCompany? @relation("OrgDatabaseImportAgency", fields: [databaseImportAgencyId], references: [id], onDelete: SetNull)

  agentCallSid   String                   @id @map("agent_call_sid")
  inboundCallId  String                   @map("inbound_call_id")
  subCompanyId   String                   @map("sub_company_id")
  conferenceRoom String                   @map("conference_room")
  userId         String                   @map("user_id")
  status         PhoneConferenceLegStatus @default(ringing)
  createdAt      DateTime                 @default(now()) @map("created_at")
  inboundCall    InboundCall              @relation(fields: [inboundCallId], references: [id], onDelete: Cascade)

  @@index([inboundCallId])
  @@index([inboundCallId, status])
  @@index([userId])
  @@map("phone_conference_legs")
}

model SigningAuthority {
  id            String     @id @default(uuid())
  subCompanyId  String     @map("sub_company_id")
  name          String
  signatureData String     @map("signature_data") @db.Text
  fontFamily    String     @map("font_family")
  isPrimary     Boolean    @default(false) @map("is_primary")
  createdBy     String     @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  subCompany SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)

  @@index([subCompanyId])
  @@map("signing_authorities")
}

// ── Software House: Projects ──────────────────────────────────────────────────

model Project {
  id           String          @id @default(uuid())
  name         String
  description  String?         @db.Text
  status       ProjectStatus   @default(active)
  ownerId      String          @map("owner_id")
  subCompanyId String?         @map("sub_company_id")
  startDate    DateTime?       @map("start_date")
  endDate      DateTime?       @map("end_date")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  owner      User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  subCompany SubCompany?     @relation(fields: [subCompanyId], references: [id])
  members    ProjectMember[]
  milestones Milestone[]
  tasks      Task[]

  @@index([subCompanyId])
  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

enum ProjectStatus {
  active
  on_hold
  done
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  userId    String            @map("user_id")
  role      ProjectMemberRole @default(member)
  createdAt DateTime          @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum ProjectMemberRole {
  member
  lead
}

model Milestone {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  title     String
  dueDate   DateTime @map("due_date")
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([dueDate])
  @@map("milestones")
}

// ── Software House: Leave ─────────────────────────────────────────────────────

model LeaveType {
  id           String         @id @default(uuid())
  name         String
  daysPerYear  Int            @map("days_per_year")
  paid         Boolean        @default(true)
  maxCarryOver Int            @default(0) @map("max_carry_over")
  subCompanyId String?        @map("sub_company_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@index([subCompanyId])
  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  leaveTypeId String    @map("leave_type_id")
  year        Int
  entitled    Int
  used        Int       @default(0)
  carriedOver Int       @default(0) @map("carried_over")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
  @@index([leaveTypeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  leaveTypeId String      @map("leave_type_id")
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  days        Int
  reason      String?     @db.Text
  status      LeaveStatus @default(pending)
  approverId  String?     @map("approver_id")
  approvedAt  DateTime?   @map("approved_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver  User?     @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum NoticeType {
  info
  warning
  holiday
  urgent
}

model Notice {
  id           String     @id @default(uuid())
  subCompanyId String     @map("sub_company_id")
  createdById  String     @map("created_by_id")
  type         NoticeType @default(info)
  title        String
  message      String     @db.Text
  pinned       Boolean    @default(false)
  expiresAt    DateTime   @map("expires_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  subCompany SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([subCompanyId])
  @@index([expiresAt])
  @@map("notices")
}

// ── Attendance ────────────────────────────────────────────────────────────────

model Attendance {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  subCompanyId String    @map("sub_company_id")
  date         DateTime  @map("date") @db.Date
  checkInAt    DateTime  @map("check_in_at")
  checkOutAt   DateTime? @map("check_out_at")
  totalMinutes Int?      @map("total_minutes")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subCompany SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([subCompanyId, date])
  @@map("attendance")
}

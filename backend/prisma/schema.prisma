/// Append-only log of performance targets set by super users for each user in an agency.
/// Each save inserts a new row (effectiveFrom = today); historical reports resolve the
/// target active on any given date via MAX(effective_from) WHERE effective_from <= report_date.
/// userId = NULL means an agency-wide default that applies to users with no individual target.
model PerformanceTarget {
  id                         String     @id @default(uuid())
  subCompanyId               String     @map("sub_company_id")
  role                       String     @map("role")
  emailsTarget               Int        @default(0) @map("emails_target")
  callsTarget                Int        @default(0) @map("calls_target")
  meetingScheduleCountTarget Int        @default(0) @map("meeting_schedule_count_target")
  effectiveFrom              DateTime   @map("effective_from") @db.Date
  createdAt                  DateTime   @default(now()) @map("created_at")
  createdById                String     @map("created_by_id")
  subCompany                 SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  createdBy                  User       @relation("PerformanceTargetCreatedBy", fields: [createdById], references: [id])

  @@index([subCompanyId])
  @@index([subCompanyId, role])
  @@index([subCompanyId, role, effectiveFrom])
  @@map("performance_targets")
}


/// Dynamic RBAC: roles, permission catalog, and role–permission grants (see prisma/seed-rbac.ts).
model RbacRole {
  id           String           @id @default(uuid())
  key          String           @unique
  name         String
  description  String?
  parentRoleId String?          @map("parent_role_id")
  sortOrder    Int              @default(0) @map("sort_order")
  isSystem     Boolean          @default(true) @map("is_system")
  isActive     Boolean          @default(true) @map("is_active")
  scopeLevel   DataScopeLevel   @default(own) @map("scope_level")
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  parent       RbacRole?        @relation("RbacRoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  children     RbacRole[]       @relation("RbacRoleHierarchy")
  permissions  RolePermission[]
  approvalCapabilities RoleApprovalCapability[]
  users        User[]

  @@index([parentRoleId])
  @@index([sortOrder])
  @@map("rbac_roles")
}

model AgencyApprovalPolicy {

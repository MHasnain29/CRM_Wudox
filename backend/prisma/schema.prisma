  @@index([stage])
  @@index([status])
  @@index([temperature])
  @@index([nextFollowUp])
  @@index([lastActivity])
  @@index([closedAt])
  @@index([reassignedFromLeadId])
  @@index([leadDeadline])
  @@index([lockedAssociateId])
  @@map("leads")

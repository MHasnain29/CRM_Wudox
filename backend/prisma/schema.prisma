  updatedById  String   @map("updated_by_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  client     Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fieldDef   ClientNoteFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  subCompany SubCompany         @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  updatedBy  User               @relation("ClientNoteFieldValueUpdatedBy", fields: [updatedById], references: [id])

  @@unique([clientId, fieldDefId, subCompanyId])
  @@index([clientId])
  @@index([fieldDefId])
  @@map("client_note_field_values")
}


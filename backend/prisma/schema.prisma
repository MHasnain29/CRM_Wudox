  requestedAt      DateTime                   @default(now()) @map("requested_at")
  reviewedAt       DateTime?                  @map("reviewed_at")
  reviewedById     String?                    @map("reviewed_by_id")
  currentStepIndex Int                        @default(0) @map("current_step_index")
  approvalChain    Json                       @default("[]") @map("approval_chain")
  lead             Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  requestedBy      User                       @relation("LeadExtensionRequester", fields: [requestedById], references: [id])
  reviewedBy       User?                      @relation("LeadExtensionReviewer", fields: [reviewedById], references: [id])

  @@index([leadId])
  @@index([status])
  @@index([requestedById])
  @@map("lead_extension_requests")
}

model LeadReassignmentRequest {
  id              String                 @id @default(uuid())
  leadId          String                 @map("lead_id")
  requestedById   String                 @map("requested_by_id")
  currentOwnerId  String                 @map("current_owner_id")
  proposedOwnerId String                 @map("proposed_owner_id")
  note                String?
  numberOfPositions   Int?                   @map("number_of_positions")
  status              LeadReassignmentStatus @default(pending)
  reviewedById        String?                @map("reviewed_by_id")
  reviewedAt          DateTime?              @map("reviewed_at")
  reviewNote          String?                @map("review_note")
  subCompanyId        String                 @map("sub_company_id")
  requestedAt     DateTime               @default(now()) @map("requested_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  currentStepIndex Int                   @default(0) @map("current_step_index")
  approvalChain    Json                 @default("[]") @map("approval_chain")

  lead          Lead       @relation(fields: [leadId], references: [id])
  requestedBy   User       @relation("ReassignmentRequester", fields: [requestedById], references: [id])
  currentOwner  User       @relation("ReassignmentCurrentOwner", fields: [currentOwnerId], references: [id])
  proposedOwner User       @relation("ReassignmentProposedOwner", fields: [proposedOwnerId], references: [id])
  reviewedBy    User?      @relation("ReassignmentReviewer", fields: [reviewedById], references: [id])
  subCompany    SubCompany @relation(fields: [subCompanyId], references: [id])

  @@index([leadId])
  @@index([requestedById])
  @@index([status])
  @@index([subCompanyId])
  @@map("lead_reassignment_requests")
}

model Call {
  id            String      @id @default(uuid())
  clientId      String?     @map("client_id")
  employeeId    String?     @map("employee_id")
  leadId        String?     @map("lead_id")
  ownerId       String      @map("owner_id")
  outcome       CallOutcome
  duration      Int?
  notes         String?
  recordingUrl  String?     @map("recording_url")
  timestamp     DateTime    @default(now())
  createdAt     DateTime    @default(now()) @map("created_at")
  subCompanyId    String      @map("sub_company_id")
  twilioCallSid   String?     @unique @map("twilio_call_sid")
  conferenceRoom  String?     @map("conference_room")
  conferenceSid   String?     @map("conference_sid")
  pstnCallSid     String?     @map("pstn_call_sid")
  transcription   String?
  client        Client?     @relation(fields: [clientId], references: [id])
  employee      Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  lead          Lead?       @relation(fields: [leadId], references: [id])
  owner         User        @relation(fields: [ownerId], references: [id])
  subCompany    SubCompany  @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([employeeId])
  @@index([leadId])
  @@index([subCompanyId])
  @@index([ownerId])
  @@index([timestamp])
  @@index([outcome])
  @@map("calls")
}

model FollowUp {
  id           String            @id @default(uuid())
  clientId     String?           @map("client_id")
  employeeId   String?           @map("employee_id")
  leadId       String?           @map("lead_id")
  contactId    String?           @map("contact_id")
  ownerId      String            @map("owner_id")
  dueDate      DateTime          @map("due_date")
  notes        String
  completed    Boolean           @default(false)
  outcome      FollowUpOutcome?
  completedAt  DateTime?         @map("completed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  subCompanyId String            @map("sub_company_id")
  /// Set during offboarding — previous owner's userId (drives "Forwarded from" chip).
  forwardedFromUserId String?           @map("forwarded_from_user_id")
  comments     FollowUpComment[]
  client       Client?           @relation(fields: [clientId], references: [id])
  employee     Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  contact      ClientContact?    @relation(fields: [contactId], references: [id])
  lead         Lead?             @relation(fields: [leadId], references: [id])
  owner        User              @relation(fields: [ownerId], references: [id])
  forwardedFromUser User?         @relation("FollowUpForwardedFrom", fields: [forwardedFromUserId], references: [id], onDelete: SetNull)
  subCompany   SubCompany        @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([employeeId])
  @@index([leadId])
  @@index([subCompanyId])
  @@index([ownerId])
  @@index([dueDate])
  @@index([completed, dueDate])
  @@map("follow_ups")
}

model FollowUpComment {
  id         String   @id @default(uuid())
  followUpId String   @map("follow_up_id")
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([followUpId])
  @@map("follow_up_comments")
}

model Task {
  id              String           @id @default(uuid())
  title           String
  description     String?
  dueDate         DateTime         @map("due_date")
  priority        TaskPriority
  status          TaskStatus
  ownerId         String           @map("owner_id")
  assignedById    String           @map("assigned_by_id")
  subCompanyId    String           @map("sub_company_id")
  reminderEnabled Boolean          @default(false) @map("reminder_enabled")
  reminderDate    DateTime?        @map("reminder_date")
  linkType        TaskLinkType?    @map("link_type")
  linkId          String?          @map("link_id")
  projectId       String?          @map("project_id")
  completedAt     DateTime?        @map("completed_at")
  /// Set during offboarding — previous owner's userId (drives "Forwarded from" chip).
  forwardedFromUserId String?      @map("forwarded_from_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  comments        TaskComment[]
  attachments     TaskAttachment[]
  assignedBy          User             @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  owner               User             @relation("TaskOwner", fields: [ownerId], references: [id])
  forwardedFromUser   User?            @relation("TaskForwardedFrom", fields: [forwardedFromUserId], references: [id], onDelete: SetNull)
  subCompany          SubCompany       @relation(fields: [subCompanyId], references: [id])
  project             Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
  @@index([linkType, linkId])
  @@index([subCompanyId])
  @@index([projectId])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  filename   String
  fileKey    String   @map("file_key")
  mimeType   String   @map("mime_type")
  size       Int?
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

model Meeting {
  id                    String            @id @default(uuid())
  clientId              String            @map("client_id")
  leadId                String?           @map("lead_id")
  ownerId               String            @map("owner_id")
  title                 String
  startTime             DateTime          @map("start_time")
  endTime               DateTime          @map("end_time")
  location              String?
  meetingLink           String?           @map("meeting_link")
  googleCalendarEventId String?           @map("google_calendar_event_id")
  agenda                String?
  notes                 String?
  status                MeetingStatus     @default(scheduled)
  /// Set during offboarding — previous owner's userId (drives "Forwarded from" chip).
  forwardedFromUserId   String?           @map("forwarded_from_user_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  subCompanyId          String            @map("sub_company_id")
  attendees             MeetingAttendee[]
  client                Client            @relation(fields: [clientId], references: [id])
  lead                  Lead?             @relation(fields: [leadId], references: [id])
  owner                 User              @relation(fields: [ownerId], references: [id])
  forwardedFromUser     User?             @relation("MeetingForwardedFrom", fields: [forwardedFromUserId], references: [id], onDelete: SetNull)
  subCompany            SubCompany        @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([leadId])
  @@index([subCompanyId])
  @@index([ownerId])
  @@index([startTime])
  @@index([startTime, endTime])
  @@index([status])
  @@map("meetings")
}

model MeetingAttendee {
  id        String         @id @default(uuid())
  meetingId String         @map("meeting_id")
  userId    String?        @map("user_id")
  contactId String?        @map("contact_id")
  contact   ClientContact? @relation(fields: [contactId], references: [id])
  meeting   Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_attendees")
}

model Job {
  id                 String          @id @default(uuid())
  /// Human-friendly unique sequential job identifier (e.g. 000001).
  jobCode            String?         @unique @map("job_code")
  templateId         String?         @map("template_id")
  jobType            JobType         @map("job_type")
  title              String
  company            String
  location           String
  department         String?
  description        String
  requirements       String
  responsibilities   String
  openPositions      Int             @default(1) @map("open_positions")
  filledPositions    Int             @default(0) @map("filled_positions")
  scheduledPositions Int             @default(0) @map("scheduled_positions")
  backupPercentage   Int             @default(70) @map("backup_percentage")
  status             JobStatus
  employmentType     EmploymentType  @map("employment_type")
  salaryMin          Decimal?        @map("salary_min") @db.Decimal(10, 2)
  salaryMax          Decimal?        @map("salary_max") @db.Decimal(10, 2)
  publishLinkedin    Boolean         @default(false) @map("publish_linkedin")
  publishIndeed      Boolean         @default(false) @map("publish_indeed")
  publishGlassdoor   Boolean         @default(false) @map("publish_glassdoor")
  publishedAt        DateTime?       @map("published_at")
  licenseRequired      Boolean  @default(false) @map("license_required")
  requiredLicenseTypes String[] @default([]) @map("required_license_types")
  /// Agency scope (nullable for legacy rows; new jobs always set it).
  subCompanyId       String?         @map("sub_company_id")
  activeClientId     String?         @map("active_client_id")
  screeningCriteria  Json?           @map("screening_criteria")
  shiftSchedule      Json?           @map("shift_schedule")
  createdById        String          @map("created_by_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  closedAt           DateTime?       @map("closed_at")
  applicantCount      Int                  @default(0) @map("applicant_count")
  assignments         JobAssignment[]
  employeeAssignments EmployeeAssignment[]
  createdBy           User                 @relation(fields: [createdById], references: [id])
  subCompany          SubCompany?          @relation(fields: [subCompanyId], references: [id], onDelete: SetNull)
  activeClient        ActiveClient?        @relation(fields: [activeClientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([jobType])
  @@index([location])
  @@index([createdById])
  @@index([subCompanyId])
  @@index([activeClientId])
  @@map("jobs")
}

model JobAssignment {
  id           String   @id @default(uuid())
  jobId        String   @map("job_id")
  employeeId   String   @map("employee_id")
  isBackup     Boolean  @default(false) @map("is_backup")
  isActive     Boolean  @default(true) @map("is_active")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String   @map("assigned_by_id")
  employee     Employee @relation(fields: [employeeId], references: [id])
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([employeeId])
  @@index([isActive])
  @@map("job_assignments")
}

model Employee {
  id                     String                   @id @default(uuid())
  employeeType           EmployeeType             @map("employee_type")
  firstName              String                   @map("first_name")
  lastName               String                   @map("last_name")
  email                  String?
  phone                  String
  alternatePhone         String?                  @map("alternate_phone")
  dateOfBirth            DateTime?                @map("date_of_birth")
  gender                 Gender?
  address                String?
  addressLine2           String?                  @map("address_line_2")
  city                   String?
  province               String?
  postalCode             String?                  @map("postal_code")
  country                String?
  emergencyContactName   String?                  @map("emergency_contact_name")
  emergencyContactPhone  String?                  @map("emergency_contact_phone")
  educationLevel         String?                  @map("education_level")
  educationFromYear      Int?                     @map("education_from_year")
  educationEndYear       Int?                     @map("education_end_year")
  graduated              Boolean?
  courseStudied          String?                  @map("course_studied")
  diplomaName            String?                  @map("diploma_name")
  experienceDuties       String?                  @map("experience_duties")
  availableFrom          DateTime?                @map("available_from") @db.Date
  availabilityTypes      String[]                 @default([]) @map("availability_types")
  skills                 String[]                 @default([]) @map("skills")
  residencyStatus        ResidencyStatus?         @map("residency_status")
  shiftsAvailable        String[]                 @default([]) @map("shifts_available")
  ableTwelveHourShift    Boolean?                 @map("able_twelve_hour_shift")
  englishProficiency     String[]                 @default([]) @map("english_proficiency")
  workStatus             EmployeeWorkStatus?      @map("work_status")
  approvalStatus         EmployeeApprovalStatus?  @map("approval_status")
  hireDate               DateTime?                @map("hire_date")
  terminationDate        DateTime?                @map("termination_date")
  position               String?
  department             String?
  hourlyRate             Decimal?                 @map("hourly_rate") @db.Decimal(10, 2)
  /// How salary is paid: cheque or direct deposit.
  salaryPaymentMethod    SalaryPaymentMethod?     @map("salary_payment_method")
  bankName               String?                  @map("bank_name")
  bankInstitutionNumber  String?                  @map("bank_institution_number")
  bankTransitNumber      String?                  @map("bank_transit_number")
  bankAccountNumber      String?                  @map("bank_account_number")
  addedById              String                   @map("added_by_id")
  approvedById           String?                  @map("approved_by_id")
  approvedAt             DateTime?                @map("approved_at")
  rejectedById           String?                  @map("rejected_by_id")
  rejectedAt             DateTime?                @map("rejected_at")
  rejectionReason        String?                  @map("rejection_reason")
  /// Role key of the user who submitted the employee for approval.
  submitterRole          String?                  @map("submitter_role")
  currentStepIndex       Int                      @default(0) @map("current_step_index")
  approvalChain          Json                     @default("[]") @map("approval_chain")
  /// PandaDoc onboarding agreement tracking.
  onboardingPandaDocId       String?              @map("onboarding_pandadoc_id")
  onboardingPandaDocStatus   String?              @map("onboarding_pandadoc_status")
  onboardingPandaDocUpdatedAt DateTime?           @map("onboarding_pandadoc_updated_at")
  /// CRM user who last sent the onboarding agreement (for signed/declined notifications).
  onboardingSentById         String?              @map("onboarding_sent_by_id")
  /// Form-only metadata (photo ID type/number, extra edu/exp, licenses, profile photo doc id).
  /// Never store SIN here.
  uiExtras               Json?                    @map("ui_extras")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  documents              EmployeeDocument[]
  notes                  EmployeeNote[]
  tags                   EmployeeTag[]
  workExperiences        EmployeeWorkExperience[]
  employeeAssignments    EmployeeAssignment[]
  activeClientTrainings  ActiveClientTrainingAssignment[]
  trainings              EmployeeTraining[]
  calls                  Call[]
  followUps              FollowUp[]
  addedBy                User                     @relation("EmployeeAddedBy", fields: [addedById], references: [id])
  approvedBy             User?                    @relation("EmployeeApprovedBy", fields: [approvedById], references: [id])
  rejectedBy             User?                    @relation("EmployeeRejectedBy", fields: [rejectedById], references: [id])
  onboardingSentBy       User?                    @relation("EmployeeOnboardingSentBy", fields: [onboardingSentById], references: [id], onDelete: SetNull)
  assignments            JobAssignment[]

  @@index([employeeType])
  @@index([workStatus])
  @@index([approvalStatus])
  @@index([email])
  @@index([onboardingPandaDocId])
  @@index([onboardingSentById])
  @@map("employees")
}

/// Standalone employee training records (not tied to client placement).
model EmployeeTraining {
  id                       String    @id @default(uuid())
  employeeId               String    @map("employee_id")
  /// Display name (e.g. Ontario 4 Steps, WHMIS).
  title                    String?
  /// Training link sent to the employee (email).
  url                      String?
  sentAt                   DateTime? @map("sent_at")
  /// How the training link was sent: email (sms removed for standalone)
  channel                  String?
  certificateDocumentId    String?   @map("certificate_document_id")
  completedAt              DateTime? @map("completed_at")
  sentById                 String?   @map("sent_by_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  employee                 Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sentBy                   User?     @relation("EmployeeTrainingSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  certificateDocument      EmployeeDocument? @relation("EmployeeTrainingCertificate", fields: [certificateDocumentId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([sentAt])
  @@index([completedAt])
  @@index([certificateDocumentId])
  @@map("employee_trainings")
}

/// Pending/approved link of an active employee to a Client, ActiveClient, or Job (step 2 approval).
model EmployeeAssignment {
  id                 String                       @id @default(uuid())
  employeeId         String                       @map("employee_id")
  targetType         EmployeeAssignmentTargetType @map("target_type")
  clientId           String?                      @map("client_id")
  /// Recruitment Active Client (preferred for recruitment placements).
  activeClientId     String?                      @map("active_client_id")
  jobId              String?                      @map("job_id")
  /// Placement details (primarily for client assignments)
  workLocation       String?                      @map("work_location")
  positionTitle      String?                      @map("position_title")
  payRate            String?                      @map("pay_rate")
  shiftSchedule      String?                      @map("shift_schedule")
  expectedDuration   String?                      @map("expected_duration")
  supervisorInfo     String?                      @map("supervisor_info")
  requiredPpe        String?                      @map("required_ppe")
  workplaceHazards   String?                      @map("workplace_hazards")
  /// When assignment details were emailed to the candidate (required before activation).
  detailsSentToCandidateAt DateTime?              @map("details_sent_to_candidate_at")
  /// Optional training checklist (does not block approval).
  trainingMessage                  String?   @map("training_message")
  trainingSentAt                   DateTime? @map("training_sent_at")
  /// How the training message was sent: email | sms
  trainingChannel                  String?   @map("training_channel")
  trainingCertificateDocumentId    String?   @map("training_certificate_document_id")
  trainingCompletedAt              DateTime? @map("training_completed_at")
  status             EmployeeAssignmentStatus     @default(pending)
  isActive           Boolean                      @default(false) @map("is_active")
  /// Requested roster role for job targets (primary vs backup pool).
  isBackup           Boolean                      @default(false) @map("is_backup")
  endedAt            DateTime?                    @map("ended_at")
  endReason          PlacementEndReason?          @map("end_reason")
  endNotes           String?                      @map("end_notes")
  rating             Int?
  submittedById      String                       @map("submitted_by_id")
  submitterRole      String?                      @map("submitter_role")
  submittedAt        DateTime                     @default(now()) @map("submitted_at")
  currentStepIndex   Int                          @default(0) @map("current_step_index")
  approvalChain      Json                         @default("[]") @map("approval_chain")
  approvedById       String?                      @map("approved_by_id")
  approvedAt         DateTime?                    @map("approved_at")
  rejectedById       String?                      @map("rejected_by_id")
  rejectedAt         DateTime?                    @map("rejected_at")
  rejectionReason    String?                      @map("rejection_reason")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  employee           Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  client             Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  activeClient       ActiveClient?                @relation(fields: [activeClientId], references: [id], onDelete: SetNull)
  job                Job?                         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  submittedBy        User                         @relation("EmployeeAssignmentSubmittedBy", fields: [submittedById], references: [id])
  approvedBy         User?                        @relation("EmployeeAssignmentApprovedBy", fields: [approvedById], references: [id])
  rejectedBy         User?                        @relation("EmployeeAssignmentRejectedBy", fields: [rejectedById], references: [id])
  trainingCertificateDocument EmployeeDocument? @relation("AssignmentTrainingCertificate", fields: [trainingCertificateDocumentId], references: [id], onDelete: SetNull)
  activeClientTraining        ActiveClientTrainingAssignment?

  @@index([employeeId])
  @@index([status])
  @@index([clientId])
  @@index([activeClientId])
  @@index([jobId])
  @@index([isActive])
  @@index([trainingCertificateDocumentId])
  @@map("employee_assignments")
}

model EmployeeWorkExperience {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  companyName   String   @map("company_name")
  contactNumber String?  @map("contact_number")
  position      String?
  duration      String?
  sortOrder     Int      @map("sort_order")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_work_experiences")
}

model EmployeeTag {
  employeeId String   @map("employee_id")
  tag        String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, tag])
  @@map("employee_tags")
}

model EmployeeDocument {
  id           String       @id @default(uuid())
  employeeId   String       @map("employee_id")
  type         DocumentType
  name         String
  fileName     String       @map("file_name")
  fileSize     BigInt       @map("file_size")
  mimeType     String?      @map("mime_type")
  url          String
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")
  uploadedById String       @map("uploaded_by_id")
  expiryDate   DateTime?    @map("expiry_date")
  notes        String?
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  trainingAssignments EmployeeAssignment[] @relation("AssignmentTrainingCertificate")
  trainingRecords     EmployeeTraining[]   @relation("EmployeeTrainingCertificate")

  @@index([employeeId])
  @@index([type])
  @@index([expiryDate])
  @@map("employee_documents")
}

model EmployeeNote {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_notes")
}

model Email {
  id            String            @id @default(uuid())
  fromUserId    String?           @map("from_user_id")
  sentByUserId  String?           @map("sent_by_user_id")
  fromName      String            @map("from_name")
  fromEmail     String            @map("from_email")
  subject       String            @db.VarChar(500)
  body          String
  folder        EmailFolder
  clientId      String?           @map("client_id")
  leadId        String?           @map("lead_id")
  inReplyTo     String?           @map("in_reply_to")
  isRead        Boolean           @default(false) @map("is_read")
  timestamp     DateTime          @default(now())
  createdAt     DateTime          @default(now()) @map("created_at")
  subCompanyId  String            @map("sub_company_id")
  toUserId      String?           @map("to_user_id")
  /// Set during offboarding — the user who receives a forwarded copy of this email.
  forwardedToUserId   String?     @map("forwarded_to_user_id")
  /// Set during offboarding — the departing user whose email this was originally.
  forwardedFromUserId String?     @map("forwarded_from_user_id")
  recipients    EmailRecipient[]
  attachments   EmailAttachment[]
  client        Client?           @relation(fields: [clientId], references: [id])
  fromUser      User?             @relation("EmailFromUser", fields: [fromUserId], references: [id])
  sentByUser    User?             @relation("EmailSentByUser", fields: [sentByUserId], references: [id])
  lead          Lead?             @relation(fields: [leadId], references: [id])
  sub_companies SubCompany        @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  toUser        User?             @relation("EmailToUser", fields: [toUserId], references: [id])
  forwardedToUser   User?         @relation("EmailForwardedTo", fields: [forwardedToUserId], references: [id], onDelete: SetNull)
  forwardedFromUser User?         @relation("EmailForwardedFrom", fields: [forwardedFromUserId], references: [id], onDelete: SetNull)

  @@index([fromUserId])
  @@index([sentByUserId])
  @@index([toUserId])
  @@index([subCompanyId])
  @@index([clientId])
  @@index([leadId])
  @@index([folder])
  @@index([timestamp])
  @@map("emails")
}

model EmailAttachment {
  id        String   @id @default(uuid())
  emailId   String   @map("email_id")
  filename  String
  fileKey   String   @map("file_key")
  mimeType  String   @map("mime_type")
  size      Int?
  createdAt DateTime @default(now()) @map("created_at")
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@map("email_attachments")
}

model EmailRecipient {
  id            String         @id @default(uuid())
  emailId       String         @map("email_id")
  recipientType String         @map("recipient_type")
  name          String?
  emailAddress  String         @map("email")
  clientId      String?        @map("client_id")
  contactId     String?        @map("contact_id")
  client        Client?        @relation(fields: [clientId], references: [id])
  contact       ClientContact? @relation(fields: [contactId], references: [id])
  emailRecord   Email          @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([emailAddress])
  @@map("email_recipients")
}

model MailingList {
  id           String                  @id @default(uuid())
  subCompanyId String                  @map("sub_company_id")
  createdById  String?                 @map("created_by_id")
  name         String
  description  String?
  isArchived   Boolean                 @default(false) @map("is_archived")
  archivedAt   DateTime?               @map("archived_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  subCompany   SubCompany              @relation(fields: [subCompanyId], references: [id])
  createdBy    User?                   @relation("MailingListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members      MailingListClient[]
  assignments  MailingListAssignment[]

  @@index([subCompanyId])
  @@index([createdById])
  @@map("mailing_lists")
}

model MailingListAssignment {
  id           String      @id @default(uuid())
  listId       String      @map("list_id")
  userId       String      @map("user_id")
  assignedById String      @map("assigned_by_id")
  assignedAt   DateTime    @default(now()) @map("assigned_at")
  list         MailingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user         User        @relation("MailingListAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User        @relation("MailingListAssignedByRel", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
  @@map("mailing_list_assignments")
}

model MailingListClient {
  id       String      @id @default(uuid())
  listId   String      @map("list_id")
  clientId String      @map("client_id")
  addedAt  DateTime    @default(now()) @map("added_at")
  list     MailingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([listId, clientId])
  @@index([listId])
  @@index([clientId])
  @@map("mailing_list_clients")
}

model EmailCampaign {
  id              String                   @id @default(uuid())
  subCompanyId    String                   @map("sub_company_id")
  name            String
  listId          String                   @map("list_id")
  listName        String                   @default("") @map("list_name")
  subject         String                   @db.VarChar(500)
  body            String
  templateId      String?                  @map("template_id")
  scheduledDate   DateTime                 @map("scheduled_date")
  status          CampaignStatus
  sentAt          DateTime?                @map("sent_at")
  totalRecipients Int                      @default(0) @map("total_recipients")
  statsSent       Int                      @default(0) @map("stats_sent")
  statsDelivered  Int                      @default(0) @map("stats_delivered")
  statsOpened     Int                      @default(0) @map("stats_opened")
  statsClicked    Int                      @default(0) @map("stats_clicked")
  statsBounced    Int                      @default(0) @map("stats_bounced")
  statsFailed     Int                      @default(0) @map("stats_failed")
  createdAt       DateTime                 @default(now()) @map("created_at")
  createdById     String?                  @map("created_by_id")
  subCompany      SubCompany               @relation(fields: [subCompanyId], references: [id])
  createdBy       User?                    @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  recipients      EmailCampaignRecipient[]

  @@index([subCompanyId])
  @@index([status])
  @@index([scheduledDate])
  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id             String               @id @default(uuid())
  campaignId     String               @map("campaign_id")
  clientId       String               @map("client_id")
  clientName     String               @map("client_name")
  email          String
  status         EmailRecipientStatus
  sentAt         DateTime?            @map("sent_at")
  deliveredAt    DateTime?            @map("delivered_at")
  openedAt       DateTime?            @map("opened_at")
  clickedAt      DateTime?            @map("clicked_at")
  bouncedAt      DateTime?            @map("bounced_at")
  spamReportedAt DateTime?            @map("spam_reported_at")
  failureReason  String?              @map("failure_reason")
  errorMessage   String?              @map("error_message")
  campaign       EmailCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@map("email_campaign_recipients")
}

/// Editable email templates (header, body, footer) for compose and campaigns.
model EmailTemplate {
  id               String          @id @default(uuid())
  subCompanyId     String?         @map("sub_company_id")
  /// null = shared (agency/global). Set = personal copy owned by that user.
  ownerUserId      String?         @map("owner_user_id")
  /// Shared template this personal copy was customized from (optional).
  sourceTemplateId String?         @map("source_template_id")
  name             String
  subject          String
  bodyHtml         String          @map("body_html")
  headerHtml       String?         @map("header_html")
  footerHtml       String?         @map("footer_html")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  subCompany       SubCompany?     @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  ownerUser        User?           @relation("EmailTemplateOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  sourceTemplate   EmailTemplate?  @relation("EmailTemplateSource", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  derivedTemplates EmailTemplate[] @relation("EmailTemplateSource")

  @@index([subCompanyId])
  @@index([ownerUserId])
  @@index([sourceTemplateId])
  @@map("email_templates")
}

model EmailSignature {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  content   String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_signatures")
}

model ActivityLog {
  id           String     @id @default(uuid())
  type         String
  userId       String     @map("user_id")
  userName     String     @map("user_name")
  subCompanyId String     @map("sub_company_id")
  description  String
  metadata     Json?
  timestamp    DateTime   @default(now())
  subCompany   SubCompany @relation(fields: [subCompanyId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([timestamp])
  @@index([subCompanyId])
  @@map("activity_logs")
}

model BugReport {
  id                String          @id @default(uuid())
  submittedById     String          @map("submitted_by_id")
  subCompanyId      String          @map("sub_company_id")
  title             String?
  description       String
  screenshotUrl     String?         @map("screenshot_url")
  status            BugReportStatus @default(open)
  resolutionRemarks String?         @map("resolution_remarks")
  resolvedById      String?         @map("resolved_by_id")
  resolvedAt        DateTime?       @map("resolved_at")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  resolvedBy        User?           @relation("BugReportResolvedBy", fields: [resolvedById], references: [id])
  subCompany        SubCompany      @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  submittedBy       User            @relation("BugReportSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([subCompanyId])
  @@index([status])
  @@index([submittedById])
  @@index([createdAt])
  @@map("bug_reports")
}

/// Emails that receive bug report notifications (super admin manages in Settings).
model BugReportRecipient {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("bug_report_recipients")
}

model Proposal {
  id                     String                        @id @default(uuid())
  leadId                 String                        @map("lead_id")
  locationType           String                        @map("location_type")
  agreementTypes         String[]                      @map("agreement_types")
  tempPricingType        String?                       @map("temp_pricing_type")
  tempPricingValue       Decimal?                      @map("temp_pricing_value") @db.Decimal(10, 2)
  tempMinimumHours       Int?                          @map("temp_minimum_hours")
  directPricingType      String?                       @map("direct_pricing_type")
  directPricingValue     Decimal?                      @map("direct_pricing_value") @db.Decimal(10, 2)
  paymentTerms           PaymentTerms                  @map("payment_terms")
  comment                String?
  clientMessage          String?                       @map("client_message")
  createdAt              DateTime                      @default(now()) @map("created_at")
  status                 ProposalStatus                @default(pending)
  rejectionComment       String?                       @map("rejection_comment")
  reviewedAt             DateTime?                     @map("reviewed_at")
  reviewedById           String?                       @map("reviewed_by_id")
  pandaDocTemplateId     String?                       @map("pandadoc_template_id")
  pandaDocTemplateName   String?                       @map("pandadoc_template_name")
  pandaDocId             String?                       @map("pandadoc_id")
  pandaDocStatus         String?                       @map("pandadoc_status")
  pandaDocUpdatedAt      DateTime?                     @map("pandadoc_updated_at")
  previewPdfUrl          String?                       @map("preview_pdf_url")
  previewPdfHash         String?                       @map("preview_pdf_hash")
  previewPdfStatus       String?                       @map("preview_pdf_status")
  activatedAt            DateTime?                     @map("activated_at")
  activatedById          String?                       @map("activated_by_id")
  reviewRequestedAt      DateTime?                     @map("review_requested_at")
  reviewRequestedById    String?                       @map("review_requested_by_id")
  reviewRejectedAt       DateTime?                     @map("review_rejected_at")
  reviewRejectedById     String?                       @map("review_rejected_by_id")
  reviewRejectionComment String?                       @map("review_rejection_comment")
  isForReview            Boolean                       @default(false) @map("is_for_review")
  reviewDocumentType     String                        @default("agreement") @map("review_document_type")
  reviewEmailSentAt      DateTime?                     @map("review_email_sent_at")
  reviewTemplateId       String?                       @map("review_template_id")
  selectedContactId      String?                       @map("selected_contact_id")
  awaitingClientDueAt    DateTime?                     @map("awaiting_client_due_at")
  awaitingClientReason   String?                       @map("awaiting_client_reason")
  createdById            String?                       @map("created_by_id")
  currentStepIndex       Int                           @default(0) @map("current_step_index")
  approvalChain          Json                          @default("[]") @map("approval_chain")
  /// Shared UUID when Both (Temp+Direct) is split into two single-type rows.
  proposalPairId         String?                       @map("proposal_pair_id")
  /// Role within a Both pair: temp | direct. Null for unpaired proposals.
  pairRole               String?                       @map("pair_role")
  attachments            ProposalAttachment[]
  proposalDocuments      ProposalDocument[]
  selectedDefaultFiles   ProposalSelectedDefaultFile[]
  extensionRequests      ProposalExtensionRequest[]
  positions              ProposalPosition[]
  lead                   Lead                          @relation(fields: [leadId], references: [id])
  selectedContact        ClientContact?                @relation("ProposalSelectedContact", fields: [selectedContactId], references: [id], onDelete: SetNull)
  reviewTemplate         ReviewTemplate?               @relation(fields: [reviewTemplateId], references: [id], onDelete: SetNull)
  reviewedBy             User?                         @relation("ProposalReviewer", fields: [reviewedById], references: [id])
  activatedBy            User?                         @relation("ProposalActivator", fields: [activatedById], references: [id])
  reviewRequestedBy      User?                         @relation("ProposalReviewRequester", fields: [reviewRequestedById], references: [id])
  reviewRejectedBy       User?                         @relation("ProposalReviewRejector", fields: [reviewRejectedById], references: [id])
  createdBy              User?                         @relation("ProposalCreatedBy", fields: [createdById], references: [id])

  @@index([leadId])
  @@index([status])
  @@index([pandaDocId])
  @@index([createdById])
  @@index([proposalPairId])
  @@map("proposals")
}

model ProposalExtensionRequest {
  id               String                         @id @default(uuid())
  proposalId       String                         @map("proposal_id")
  requestedById    String                         @map("requested_by_id")
  reason           String
  requestedDays    Int                            @map("requested_days")
  status           ProposalExtensionRequestStatus @default(pending)
  reviewedById     String?                        @map("reviewed_by_id")
  reviewedAt       DateTime?                      @map("reviewed_at")
  reviewComment    String?                        @map("review_comment")
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")
  currentStepIndex Int                            @default(0) @map("current_step_index")
  approvalChain    Json                           @default("[]") @map("approval_chain")
  proposal         Proposal                       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  requestedBy      User                           @relation("ProposalExtensionRequester", fields: [requestedById], references: [id])
  reviewedBy       User?                          @relation("ProposalExtensionReviewedBy", fields: [reviewedById], references: [id])

  @@index([proposalId])
  @@index([status])
  @@index([requestedById])
  @@map("proposal_extension_requests")
}

model ProposalAttachment {
  id         String   @id @default(uuid())
  proposalId String   @map("proposal_id")
  name       String
  size       BigInt
  type       String
  url        String
  createdAt  DateTime @default(now()) @map("created_at")
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_attachments")
}

/// Positions requested in a proposal (name + count).
model ProposalPosition {
  id         String   @id @default(uuid())
  proposalId String   @map("proposal_id")
  name       String
  count      Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_positions")
}

/// Snapshot of director-set default files selected at proposal submission time.
model ProposalSelectedDefaultFile {
  id            String   @id @default(uuid())
  proposalId    String   @map("proposal_id")
  defaultFileId String?  @map("default_file_id")
  name          String
  fileUrl       String   @map("file_url")
  mimeType      String?  @map("mime_type")
  createdAt     DateTime @default(now()) @map("created_at")
  proposal      Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_selected_default_files")
}

/// Documents exchanged during the Closed Won Pending phase (sent to client / received from client).
model ProposalDocument {
  id             String                   @id @default(uuid())
  proposalId     String                   @map("proposal_id")
  category       ProposalDocumentCategory
  name           String
  size           BigInt
  type           String
  url            String
  uploadedById   String                   @map("uploaded_by_id")
  /// For sent_to_client: the contact this document was emailed to
  contactId      String?                  @map("contact_id")
  contactName    String?                  @map("contact_name")
  contactEmail   String?                  @map("contact_email")
  sentAt         DateTime?                @map("sent_at")
  deliveryStatus String?                  @map("delivery_status")
  createdAt      DateTime                 @default(now()) @map("created_at")
  proposal       Proposal                 @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  uploadedBy     User                     @relation("ProposalDocumentUploader", fields: [uploadedById], references: [id])

  @@index([proposalId])
  @@map("proposal_documents")
}

enum ProposalDocumentCategory {
  sent_to_client
  received_from_client
  generated_for_review
}

model Document {
  id            String     @id @default(uuid())
  name          String
  type          String
  templateId    String?    @map("template_id")
  clientId      String?    @map("client_id")
  leadId        String?    @map("lead_id")
  subCompanyId  String     @map("sub_company_id")
  /// When true, attachment is visible to all agencies (director/super_admin uploads).
  isPublic      Boolean    @default(false) @map("is_public")
  content       Json?
  fileUrl       String?    @map("file_url")
  generatedById String?    @map("generated_by_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  client        Client?    @relation(fields: [clientId], references: [id])
  lead          Lead?      @relation(fields: [leadId], references: [id])
  subCompany    SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([leadId])
  @@index([subCompanyId])
  @@index([clientId, subCompanyId])
  @@index([isPublic])
  @@index([type])
  @@map("documents")
}

model LeadRequest {
  id            String               @id @default(uuid())
  clientId      String               @map("client_id")
  requestedById String               @map("requested_by_id")
  managerId     String               @map("manager_id")
  note          String
  status        LeadRequestStatus
  reviewedById  String?              @map("reviewed_by_id")
  reviewedAt    DateTime?            @map("reviewed_at")
  subCompanyId  String               @map("sub_company_id")
  requestedAt   DateTime             @default(now()) @map("requested_at")
  currentStepIndex Int              @default(0) @map("current_step_index")
  approvalChain    Json             @default("[]") @map("approval_chain")
  comments      LeadRequestComment[]
  client        Client               @relation(fields: [clientId], references: [id])
  manager       User                 @relation("LeadRequestManager", fields: [managerId], references: [id])
  requestedBy   User                 @relation("LeadRequestRequester", fields: [requestedById], references: [id])
  reviewedBy    User?                @relation("LeadRequestReviewer", fields: [reviewedById], references: [id])
  subCompany    SubCompany           @relation(fields: [subCompanyId], references: [id])

  @@index([clientId])
  @@index([requestedById])
  @@index([managerId])
  @@index([status])
  @@index([subCompanyId])
  @@map("lead_requests")
}

model LeadRequestComment {
  id        String      @id @default(uuid())
  requestId String      @map("request_id")
  userId    String      @map("user_id")
  userName  String      @map("user_name")
  text      String
  createdAt DateTime    @default(now()) @map("created_at")
  request   LeadRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("lead_request_comments")
}

model UserAvailability {
  userId          String          @id @map("user_id")
  meetingDuration Int             @default(30) @map("meeting_duration")
  bufferTime      Int             @default(15) @map("buffer_time")
  bookingLinkSlug String          @unique @map("booking_link_slug")
  timezone        String          @default("America/Toronto")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  meetings        BookedMeeting[]
  timeSlots       TimeSlot[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingLinkSlug])
  @@map("user_availability")
}

model TimeSlot {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  dayOfWeek        DayOfWeek        @map("day_of_week")
  startTime        String           @map("start_time")
  endTime          String           @map("end_time")
  isEnabled        Boolean          @default(true) @map("is_enabled")
  createdAt        DateTime         @default(now()) @map("created_at")
  userAvailability UserAvailability @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([userId, dayOfWeek])
  @@map("time_slots")
}

model BookedMeeting {
  id           String              @id @default(uuid())
  hostUserId   String              @map("host_user_id")
  guestName    String              @map("guest_name")
  guestEmail   String              @map("guest_email")
  guestCompany String?             @map("guest_company")
  startTime    DateTime            @map("start_time")
  endTime      DateTime            @map("end_time")
  meetingLink  String?             @map("meeting_link")
  notes        String?
  status       BookedMeetingStatus
  createdAt    DateTime            @default(now()) @map("created_at")
  host         UserAvailability    @relation(fields: [hostUserId], references: [userId])

  @@index([hostUserId])
  @@index([startTime])
  @@index([status])
  @@map("booked_meetings")
}

model FilterView {
  id        String         @id @default(uuid())
  name      String
  type      FilterViewType
  userId    String         @map("user_id")
  filters   Json
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("filter_views")
}

/// 1:1 or small group chat within an agency. Participants are agency users.
model Conversation {
  id           String                    @id @default(uuid())
  subCompanyId String                    @map("sub_company_id")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  participants ConversationParticipant[]
  subCompany   SubCompany                @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([subCompanyId])
  @@map("conversations")
}

/// User in a conversation; lastReadAt used for unread count.
model ConversationParticipant {
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  lastReadAt     DateTime?    @map("last_read_at")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String              @id @default(uuid())
  conversationId String              @map("conversation_id")
  senderId       String              @map("sender_id")
  text           String?
  // text (default) | call — internal WebRTC history rows
  type           String              @default("text")
  // For type=call: { mediaType, outcome, durationSec, callId }
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  attachments    MessageAttachment[]
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SubCompany {
  id                            String                         @id @default(uuid())
  name                          String
  /// Optional company display name for public sign-in and director/super-admin app chrome; when unset, `name` is used there.
  appProjectName                String?                        @map("app_project_name")
  /// Company / parent brand image: public sign-in + in-app chrome for super_admin and director only.
  logoUrl                       String?                        @map("logo_url")
  /// Agency mark: sidebar for all roles at this agency; outbound emails use with organization `name`.
  agencyLogoUrl                 String?                        @map("agency_logo_url")
  /// Optional agency contact email (public-facing / directory).
  agencyEmail                   String?                        @map("agency_email")
  /// Optional agency phone number.
  agencyPhone                   String?                        @map("agency_phone")
  emailFooterText               String?                        @map("email_footer_text")
  emailSignatureTemplate        String?                        @map("email_signature_template")  @db.Text
  /// Visual builder config (JSON SignatureConfig v2). When set, template HTML is machine-generated from this.
  emailSignatureConfig          Json?                          @map("email_signature_config")
  emailTagline                  String?                        @map("email_tagline")
  /// SendGrid-authenticated From address for outbound emails. Null → falls back to env EMAIL_FROM.
  emailFromAddress              String?                        @map("email_from_address")
  /// Display name in the From field. Null → falls back to env EMAIL_FROM_NAME.
  emailFromName                 String?                        @map("email_from_name")
  /// Domain whose users may send as themselves (e.g. hrglobal.ca). Null → send-as disabled for this agency.
  emailSendAsDomain             String?                        @map("email_send_as_domain")
  /// Phase 2: per-agency inbound parse subdomain for reply routing. Null → falls back to env EMAIL_INBOUND_DOMAIN.
  emailInboundDomain            String?                        @map("email_inbound_domain")
  /// Phase 2: local-part for the inbound reply-to address. Null → falls back to env EMAIL_INBOUND_LOCALPART.
  emailInboundLocalpart         String?                        @map("email_inbound_localpart")
  mainOrgId                     String
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  activityLogs                  ActivityLog[]
  allowedIndustries             AllowedIndustry[]
  allowedJobTitles              AllowedJobTitle[]
  allowedTags                   AllowedTag[]
  bugReports                    BugReport[]
  callScripts                   CallScript[]
  calls                         Call[]
  clientNotes                   ClientNote[]
  clientNoteFieldDefs           ClientNoteFieldDef[]
  clientNoteFieldValues         ClientNoteFieldValue[]
  remarks                       Remark[]
  clientSubCompanies            ClientSubCompany[]
  clientTags                    ClientTag[]
  clientVisibilitySetting       ClientVisibilitySetting?
  dailyReportSetting            DailyReportSetting?
  idleTimeSetting               IdleTimeSetting?
  conversations                 Conversation[]
  emailCampaigns                EmailCampaign[]
  mailingLists                  MailingList[]
  emailTemplates                EmailTemplate[]
  emails                        Email[]
  followUps                     FollowUp[]
  industryRequests              IndustryRequest[]
  jobTitleRequests              JobTitleRequest[]
  leadRequests                  LeadRequest[]
  leads                         Lead[]
  meetings                      Meeting[]
  operationsManagerAssignments  OperationsManagerSubCompany[]
  pipelineStages                PipelineStage[]
  tagRequests                   TagRequest[]
  tasks                         Task[]
  users                         User[]
  googleRefreshToken            String?                        @map("google_refresh_token")
  googleCalendarConnected       Boolean                        @default(false) @map("google_calendar_connected")
  googleConnectedEmail          String?                        @map("google_connected_email")
  proposalDefaultFiles          ProposalDefaultFile[]
  proposalDefaultSetting        ProposalDefaultSetting?
  proposalAwaitingClientSetting ProposalAwaitingClientSetting?
  leadDeadlineSetting           LeadDeadlineSetting?
  proposalTypeTemplateMapping   ProposalTypeTemplateMapping?
  emailSendWindowSettings       EmailSendWindowSetting[]
  outboundEmailQueues           OutboundEmailQueue[]
  performanceTargets            PerformanceTarget[]
  reviewTemplates               ReviewTemplate[]
  reviewTemplateMapping         ReviewTemplateMapping?
  pendingImportedClients        PendingImportedClient[]
  pendingImportedContacts       PendingImportedContact[]
  pendingClientSubmissions      PendingClientSubmission[]
  pendingClientEdits            PendingClientEdit[]
  importMappingTemplates        ImportMappingTemplate[]
  leadReassignmentRequests      LeadReassignmentRequest[]
  documents                     Document[]
  agencyApprovalPolicy          AgencyApprovalPolicy?
  agencyNotificationRules       AgencyNotificationRule[]
  orgDatabaseImportPolicies     OrgApprovalPolicy[]      @relation("OrgDatabaseImportAgency")
  offboardingLogs               OffboardingLog[]
  phoneAgencyConfig             PhoneAgencyConfig?
  phoneNumbers                  PhoneNumber[]
  inboundCalls                  InboundCall[]
  signingAuthorities            SigningAuthority[]
  activeClients                 ActiveClient[]
  jobs                          Job[]
  projects                      Project[]
  notices                       Notice[]
  attendance                    Attendance[]

  @@index([mainOrgId])
  @@map("sub_companies")
}

/// Recruitment-side client (separate from Marketing Client DB).
model ActiveClient {
  id              String            @id @default(uuid())
  name            String
  industry        String
  location        String
  contactName     String            @map("contact_name")
  contactEmail    String            @map("contact_email")
  contactPhone    String            @map("contact_phone")
  status          ActiveClientStatus @default(active)
  notes           String?
  /// When true, employees linked to this client's jobs require client training paperwork.
  clientTraining  Boolean           @default(false) @map("client_training")
  trainingFileKey String?           @map("training_file_key")
  trainingFileName String?          @map("training_file_name")
  trainingMimeType String?          @map("training_mime_type")
  trainingFileSize BigInt?          @map("training_file_size")
  /// PandaDoc template for client training (preferred over uploaded PDF when set).
  trainingPandaDocTemplateId   String? @map("training_pandadoc_template_id")
  trainingPandaDocTemplateName String? @map("training_pandadoc_template_name")
  subCompanyId    String            @map("sub_company_id")
  createdById     String            @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  subCompany      SubCompany        @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("ActiveClientCreatedBy", fields: [createdById], references: [id])
  jobs            Job[]
  employeeAssignments EmployeeAssignment[]
  clientTrainingAssignments ActiveClientTrainingAssignment[]

  @@index([subCompanyId])
  @@index([subCompanyId, status])
  @@index([name])
  @@map("active_clients")
}

/// Per job-assignment snapshot of Active Client training (separate from Ontario/WHMIS EmployeeTraining).
model ActiveClientTrainingAssignment {
  id                 String                       @id @default(uuid())
  employeeId         String                       @map("employee_id")
  activeClientId     String                       @map("active_client_id")
  assignmentId       String                       @unique @map("assignment_id")
  status             ActiveClientTrainingStatus   @default(pending)
  /// Snapshot of the client template at link/send time (kept when Active Client template is replaced).
  templateFileKey    String                       @map("template_file_key")
  templateFileName   String                       @map("template_file_name")
  templateMimeType   String?                      @map("template_mime_type")
  templateFileSize   BigInt?                      @map("template_file_size")
  sentAt             DateTime?                    @map("sent_at")
  sentByUserId       String?                      @map("sent_by_user_id")
  signedFileKey      String?                      @map("signed_file_key")
  signedFileName     String?                      @map("signed_file_name")
  signedMimeType     String?                      @map("signed_mime_type")
  signedFileSize     BigInt?                      @map("signed_file_size")
  completedAt        DateTime?                    @map("completed_at")
  completedByUserId  String?                      @map("completed_by_user_id")
  pandaDocId         String?                      @map("pandadoc_id")
  pandaDocStatus     String?                      @map("pandadoc_status")
  pandaDocUpdatedAt  DateTime?                    @map("pandadoc_updated_at")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  employee           Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  activeClient       ActiveClient                 @relation(fields: [activeClientId], references: [id], onDelete: Cascade)
  assignment         EmployeeAssignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sentBy             User?                        @relation("ActiveClientTrainingSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  completedBy        User?                        @relation("ActiveClientTrainingCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([activeClientId])
  @@index([status])
  @@index([pandaDocId])
  @@map("active_client_training_assignments")
}

/// Per-agency view of a client: status/tab (Active, Ex, Contacted, etc.) and last activity at agency level.
/// All agencies share the same client record; each agency has its own status and activity.
model ClientSubCompany {
  id           String       @id @default(uuid())
  clientId     String       @map("client_id")
  subCompanyId String       @map("sub_company_id")
  status       ClientStatus
  lastActivity DateTime?    @map("last_activity")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subCompany   SubCompany   @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)

  @@unique([clientId, subCompanyId])
  @@index([subCompanyId])
  @@index([subCompanyId, status])
  @@map("client_sub_companies")
}

model Location {
  id        String   @id @default(uuid())
  name      String
  address   String?
  country   Country
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("locations")
}

model User {
  id                                      String                        @id @default(uuid())
  email                                   String                        @unique
  passwordHash                            String                        @map("password_hash")
  firstName                               String                        @map("first_name")
  lastName                                String                        @map("last_name")
  phone                                   String?
  country                                 Country
  role                                    String                        @db.VarChar(64)
  roleId                                  String?                       @map("role_id")
  userType                                String                        @map("user_type")
  subCompanyId                            String?                       @map("sub_company_id")
  locationId                              String?                       @map("location_id")
  accessibleLocationIds                   String[]                      @map("accessible_location_ids")
  reportingManagerIds                     String[]                      @map("reporting_manager_ids")
  avatarUrl                               String?                       @map("avatar_url")
  dailyCallsTarget                        Int                           @default(0) @map("daily_calls_target")
  dailyEmailsTarget                       Int                           @default(0) @map("daily_emails_target")
  dailyMeetingScheduleTarget              Int                           @default(0) @map("daily_meeting_schedule_target")
  workStartTime                           String                        @default("09:00") @map("work_start_time")
  workEndTime                             String                        @default("17:00") @map("work_end_time")
  startDate                               DateTime?                     @map("start_date")
  probationOverride                       Boolean                       @default(false) @map("probation_override")
  sendAsEmail                             String?                       @map("send_as_email")
  sendAsDisabled                          Boolean                       @default(false) @map("send_as_disabled")
  isActive                                Boolean                       @default(true) @map("is_active")
  offboardingStartedAt                    DateTime?                     @map("offboarding_started_at")
  /// Set during offboarding commit — new inbound emails for this user are routed here instead.
  emailForwardingToUserId                 String?                       @map("email_forwarding_to_user_id")
  /// Super Admin can grant this to let any user run the offboarding wizard.
  canActAsAdmin                           Boolean                       @default(false) @map("can_act_as_admin")
  lastLoginAt                             DateTime?                     @map("last_login_at")
  createdAt                               DateTime                      @default(now()) @map("created_at")
  updatedAt                               DateTime                      @updatedAt @map("updated_at")
  activityLogs                            ActivityLog[]
  bugReportsResolved                      BugReport[]                   @relation("BugReportResolvedBy")
  bugReportsSubmitted                     BugReport[]                   @relation("BugReportSubmittedBy")
  calls                                   Call[]
  answeredInboundCalls                    InboundCall[]                 @relation("InboundCallAnsweredBy")
  inboundCallParticipants                 InboundCallParticipant[]
  clientNotes                             ClientNote[]
  clientNoteFieldDefsCreated              ClientNoteFieldDef[]          @relation("ClientNoteFieldDefCreatedBy")
  clientNoteFieldValuesUpdated            ClientNoteFieldValue[]        @relation("ClientNoteFieldValueUpdatedBy")
  remarks                                 Remark[]
  clientRestrictions                      ClientRestriction[]
  conversationParticipants                ConversationParticipant[]
  sentEmails                              Email[]                       @relation("EmailFromUser")
  sentOnBehalfEmails                      Email[]                       @relation("EmailSentByUser")
  receivedEmails                          Email[]                       @relation("EmailToUser")
  forwardedToEmails                       Email[]                       @relation("EmailForwardedTo")
  forwardedFromEmails                     Email[]                       @relation("EmailForwardedFrom")
  forwardedFromClients                    Client[]                      @relation("ClientForwardedFrom")
  forwardedFromLeads                      Lead[]                        @relation("LeadForwardedFrom")
  forwardedFromMeetings                   Meeting[]                     @relation("MeetingForwardedFrom")
  forwardedFromTasks                      Task[]                        @relation("TaskForwardedFrom")
  forwardedFromFollowUps                  FollowUp[]                    @relation("FollowUpForwardedFrom")
  emailSignatures                         EmailSignature[]
  ownedEmailTemplates                     EmailTemplate[]                @relation("EmailTemplateOwner")
  uploadedDocuments                       EmployeeDocument[]
  addedEmployees                          Employee[]                    @relation("EmployeeAddedBy")
  approvedEmployees                       Employee[]                    @relation("EmployeeApprovedBy")
  rejectedEmployees                       Employee[]                    @relation("EmployeeRejectedBy")
  employeesOnboardingSent                 Employee[]                    @relation("EmployeeOnboardingSentBy")
  employeeAssignmentsSubmitted            EmployeeAssignment[]          @relation("EmployeeAssignmentSubmittedBy")
  employeeAssignmentsApproved             EmployeeAssignment[]          @relation("EmployeeAssignmentApprovedBy")
  employeeAssignmentsRejected             EmployeeAssignment[]          @relation("EmployeeAssignmentRejectedBy")
  employeeTrainingsSent                   EmployeeTraining[]            @relation("EmployeeTrainingSentBy")
  filterViews                             FilterView[]
  followUps                               FollowUp[]
  industryRequestsDecided                 IndustryRequest[]             @relation("IndustryDecidedBy")
  industryRequestsRequested               IndustryRequest[]             @relation("IndustryRequestedBy")
  jobTitleRequestsDecided                 JobTitleRequest[]             @relation("JobTitleDecidedBy")
  jobTitleRequestsRequested               JobTitleRequest[]             @relation("JobTitleRequestedBy")
  createdJobs                             Job[]
  createdActiveClients                    ActiveClient[]                @relation("ActiveClientCreatedBy")
  activeClientTrainingsSent               ActiveClientTrainingAssignment[] @relation("ActiveClientTrainingSentBy")
  activeClientTrainingsCompleted          ActiveClientTrainingAssignment[] @relation("ActiveClientTrainingCompletedBy")
  managedLeadRequests                     LeadRequest[]                 @relation("LeadRequestManager")
  leadRequests                            LeadRequest[]                 @relation("LeadRequestRequester")
  reviewedLeadRequests                    LeadRequest[]                 @relation("LeadRequestReviewer")
  requestedLeadExtensions                 LeadExtensionRequest[]        @relation("LeadExtensionRequester")
  reviewedLeadExtensions                  LeadExtensionRequest[]        @relation("LeadExtensionReviewer")
  leadReassignmentRequestsMade            LeadReassignmentRequest[]     @relation("ReassignmentRequester")
  leadReassignmentRequestsAsOldOwner      LeadReassignmentRequest[]     @relation("ReassignmentCurrentOwner")
  leadReassignmentRequestsAsNewOwner      LeadReassignmentRequest[]     @relation("ReassignmentProposedOwner")
  leadReassignmentRequestsReviewed        LeadReassignmentRequest[]     @relation("ReassignmentReviewer")
  closedLeads                             Lead[]                        @relation("LeadClosedBy")
  ownedLeads                              Lead[]                        @relation("LeadOwner")
  reassignedLeads                         Lead[]                        @relation("LeadReassignedBy")
  meetings                                Meeting[]
  sentMessages                            Message[]
  notifications                           Notification[]
  managedSubCompanies                     OperationsManagerSubCompany[]
  reviewedProposals                       Proposal[]                    @relation("ProposalReviewer")
  reviewedProposalExtensions              ProposalExtensionRequest[]    @relation("ProposalExtensionReviewedBy")
  requestedProposalExtensions             ProposalExtensionRequest[]    @relation("ProposalExtensionRequester")
  activatedProposals                      Proposal[]                    @relation("ProposalActivator")
  reviewRequestedProposals                Proposal[]                    @relation("ProposalReviewRequester")
  reviewRejectedProposals                 Proposal[]                    @relation("ProposalReviewRejector")
  createdProposals                        Proposal[]                    @relation("ProposalCreatedBy")
  createdCampaigns                        EmailCampaign[]               @relation("CampaignCreatedBy")
  uploadedReviewTemplates                 ReviewTemplate[]              @relation("ReviewTemplateUploader")
  uploadedProposalDocuments               ProposalDocument[]            @relation("ProposalDocumentUploader")
  tagRequestsDecided                      TagRequest[]                  @relation("TagDecidedBy")
  tagRequestsRequested                    TagRequest[]                  @relation("TagRequestedBy")
  assignedByTasks                         Task[]                        @relation("TaskAssignedBy")
  assignedTasks                           Task[]                        @relation("TaskOwner")
  userAvailability                        UserAvailability?
  activitySessions                        UserActivitySession[]
  performanceTargetsCreated               PerformanceTarget[]           @relation("PerformanceTargetCreatedBy")
  location                                Location?                     @relation(fields: [locationId], references: [id])
  subCompany                              SubCompany?                   @relation(fields: [subCompanyId], references: [id])
  clientsCreated                          Client[]                      @relation("ClientCreatedBy")
  pendingImportedClients                  PendingImportedClient[]
  pendingImportedContacts                 PendingImportedContact[]
  pendingClientSubmissions                PendingClientSubmission[]     @relation("PendingClientSubmittedBy")
  pendingClientSubmissionsManagerApproved PendingClientSubmission[]     @relation("PendingClientManagerApprovedBy")
  pendingClientEdits                      PendingClientEdit[]           @relation("PendingClientEditSubmittedBy")
  pendingClientEditsManagerApproved       PendingClientEdit[]           @relation("PendingClientEditManagerApprovedBy")
  importMappingTemplates                  ImportMappingTemplate[]
  createdMailingLists                     MailingList[]                 @relation("MailingListCreatedBy")
  mailingListAssignments                  MailingListAssignment[]       @relation("MailingListAssignee")
  mailingListAssignmentsMade              MailingListAssignment[]       @relation("MailingListAssignedByRel")
  rbacRole                                RbacRole?                     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  offboardingLogsDeparting                OffboardingLog[]              @relation("OffboardingDeparting")
  offboardingLogsAdmin                    OffboardingLog[]              @relation("OffboardingAdmin")
  emailForwardingToUser                   User?                         @relation("EmailForwardingTo", fields: [emailForwardingToUserId], references: [id], onDelete: SetNull)
  emailForwardingUsers                    User[]                        @relation("EmailForwardingTo")
  agencyLinks                             UserAgencyLink[]
  ownedProjects                           Project[]                     @relation("ProjectOwner")
  projectMemberships                      ProjectMember[]
  leaveBalances                           LeaveBalance[]
  leaveRequests                           LeaveRequest[]
  leaveRequestsApproved                   LeaveRequest[]                @relation("LeaveApprover")
  notices                                 Notice[]
  attendance                              Attendance[]

  @@index([email])
  @@index([subCompanyId])
  @@index([role])
  @@index([roleId])
  @@index([locationId])
  @@index([isActive])
  @@index([offboardingStartedAt])
  @@index([emailForwardingToUserId])
  @@map("users")
}

/// Manual “Add Client” submissions awaiting director approval (per agency or global database).
model PendingClientSubmission {
  id                  String                      @id @default(uuid())
  subCompanyId        String?                     @map("sub_company_id")
  submissionSource    PendingClientSubmissionSource @default(agency) @map("submission_source")
  submittedById       String     @map("submitted_by_id")
  name                String
  industry            String?
  location            String?
  address             String?
  companySize         String?    @map("company_size")
  tags                String[]   @default([])
  contacts            Json       @default("[]")
  locationAddress     Json?      @map("location_address")
  submitterRole       String?    @map("submitter_role")
  submittedAt         DateTime   @default(now()) @map("submitted_at")
  currentStepIndex    Int        @default(0) @map("current_step_index")
  approvalChain       Json       @default("[]") @map("approval_chain")
  /// Sales / recruitment / ops manager pre-approval — does not create a client until a director approves.
  managerApprovedAt   DateTime?  @map("manager_approved_at")
  managerApprovedById String?    @map("manager_approved_by_id")
  subCompany          SubCompany? @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  submittedBy         User       @relation("PendingClientSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  managerApprovedBy   User?      @relation("PendingClientManagerApprovedBy", fields: [managerApprovedById], references: [id], onDelete: SetNull)

  @@index([subCompanyId])
  @@index([submissionSource])
  @@index([submittedAt])
  @@index([managerApprovedById])
  @@map("pending_client_submissions")
}

/// Manual client detail edits awaiting director approval (per agency).
model PendingClientEdit {
  id                  String     @id @default(uuid())
  subCompanyId        String     @map("sub_company_id")
  clientId            String     @map("client_id")
  submittedById       String     @map("submitted_by_id")
  name                String
  industry            String?
  location            String?
  address             String?
  companySize         String?    @map("company_size")
  tags                String[]   @default([])
  contacts            Json       @default("[]")
  locationAddress     Json?      @map("location_address")
  submitterRole       String?    @map("submitter_role")
  submittedAt         DateTime   @default(now()) @map("submitted_at")
  currentStepIndex    Int        @default(0) @map("current_step_index")
  approvalChain       Json       @default("[]") @map("approval_chain")
  managerApprovedAt   DateTime?  @map("manager_approved_at")
  managerApprovedById String?    @map("manager_approved_by_id")
  subCompany          SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  client              Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submittedBy         User       @relation("PendingClientEditSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  managerApprovedBy   User?      @relation("PendingClientEditManagerApprovedBy", fields: [managerApprovedById], references: [id], onDelete: SetNull)

  @@unique([clientId, subCompanyId])
  @@index([subCompanyId])
  @@index([submittedAt])
  @@index([managerApprovedById])
  @@map("pending_client_edits")
}

model PendingImportedClient {
  id           String                      @id @default(uuid())
  subCompanyId String?                     @map("sub_company_id")
  submissionSource PendingClientSubmissionSource @default(agency) @map("submission_source")
  importedById String     @map("imported_by_id")
  name         String
  industry     String?
  location     String?
  address      String?
  companySize  String?    @map("company_size")
  website      String?
  employees    String?
  /// Raw "ID" column from the source file (e.g. "NA1") — used as the in-file grouping key.
  sourceId     String?    @map("source_id")
  tags         String[]
  /// Multi-contact list: [{ name, title?, email?, phone?, extension?, linkedin? }]
  contacts     Json       @default("[]")
  importedAt   DateTime   @default(now()) @map("imported_at")
  currentStepIndex Int    @default(0) @map("current_step_index")
  approvalChain    Json   @default("[]") @map("approval_chain")
  subCompany   SubCompany? @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  importedBy   User       @relation(fields: [importedById], references: [id], onDelete: Cascade)

  @@index([subCompanyId])
  @@index([submissionSource])
  @@map("pending_imported_clients")
}

/// Staged contact-only CSV/Excel import: contacts append to an existing client on approve.
model PendingImportedContact {
  id               String                        @id @default(uuid())
  subCompanyId     String?                       @map("sub_company_id")
  submissionSource PendingClientSubmissionSource @default(agency) @map("submission_source")
  importedById     String                        @map("imported_by_id")
  targetClientId   String                        @map("target_client_id")
  /// How the client was matched: corporateCode | companyName | importSourceId
  matchKey         String                        @map("match_key")
  matchValue       String                        @map("match_value")
  /// Multi-contact list: [{ name, title?, email?, phone?, extension?, linkedin?, isPrimary? }]
  contacts         Json                          @default("[]")
  importedAt       DateTime                      @default(now()) @map("imported_at")
  currentStepIndex Int                           @default(0) @map("current_step_index")
  approvalChain    Json                          @default("[]") @map("approval_chain")
  subCompany       SubCompany?                   @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  importedBy       User                          @relation(fields: [importedById], references: [id], onDelete: Cascade)
  targetClient     Client                        @relation(fields: [targetClientId], references: [id], onDelete: Cascade)

  @@index([subCompanyId])
  @@index([submissionSource])
  @@index([targetClientId])
  @@index([importedAt])
  @@map("pending_imported_contacts")
}

/// Saved column → CRM-field mapping per agency, keyed by a fingerprint of the source file's
/// headers. When the same vendor's file is re-uploaded, the wizard pre-fills the mapping.
model ImportMappingTemplate {
  id                String     @id @default(uuid())
  subCompanyId      String     @map("sub_company_id")
  /// client = company+contacts import; contact = contacts-only import
  entityType        String     @default("client") @map("entity_type")
  name              String?
  headerFingerprint String     @map("header_fingerprint")
  /// { "<source column>": "<crmField | _ignore>" }
  mapping           Json
  createdById       String     @map("created_by_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  subCompany        SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  createdBy         User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([subCompanyId, entityType, headerFingerprint])
  @@index([subCompanyId])
  @@map("import_mapping_templates")
}

/// Which agencies (sub-companies) an operations manager is assigned to. Only for role operations_manager.
model OperationsManagerSubCompany {
  userId       String     @map("user_id")
  subCompanyId String     @map("sub_company_id")
  agencyEmail  String?    @map("agency_email")
  createdAt    DateTime   @default(now()) @map("created_at")
  subCompany   SubCompany @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, subCompanyId])
  @@index([subCompanyId])
  @@index([agencyEmail])
  @@map("operations_manager_sub_companies")
}

/// IP restriction by role (and optional country): users matching role/country can only login from allowed IPs.
model IpRestrictionRule {
  id         String   @id @default(uuid())
  role       String   @db.VarChar(64)
  country    Country?
  allowedIps String   @map("allowed_ips")
  name       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([role, country])
  @@index([role])
  @@index([country])
  @@map("ip_restriction_rules")
}

model Client {
  id                   String                 @id @default(uuid())
  /// Stable per-client serial used for cross-associate verbal references (e.g. "client #312").
  /// Permanent and unique; assigned at insert and never changes.
  serialNumber         Int                    @unique @default(autoincrement()) @map("serial_number")
  name                 String
  industry             String?
  location             String?
  address              String?
  companySize          String?                @map("company_size")
  status               ClientStatus
  lastActivity         DateTime?              @map("last_activity")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  /// Business identity (e.g. NESTLE, COCA-COLA). Not a DB FK; use for display/linking. DB row id stays the FK.
  corporateCode        String                 @unique @map("corporate_code")
  visibility           ClientVisibility       @default(global)
  /// UserRole value of the creator at the time of client creation (not the user's current role)
  createdByRole        String?                @map("created_by_role")
  /// User who created or submitted the client (e.g. database manager after approval)
  createdById          String?                @map("created_by_id")
  createdBy            User?                  @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// Set when an agency-scoped client is auto-promoted to global visibility
  visibilityPromotedAt DateTime?              @map("visibility_promoted_at")
  /// Self-FK for parent ↔ branch relationship (e.g. Nestlé Global ← Nestlé Canada).
  parentClientId       String?                @map("parent_client_id")
  parent               Client?                @relation("ClientBranches", fields: [parentClientId], references: [id], onDelete: SetNull)
  branches             Client[]               @relation("ClientBranches")
  /// Raw "ID" column from the source file at import time (e.g. "NA1"). Lets us trace
  /// any client back to the batch/vendor reference it came from. Null for manually-added clients.
  importSourceId       String?                @map("import_source_id")
  /// 'management' | 'associate' — who owns this client record. Set by super users only.
  ownershipType        String?                @map("ownership_type")
  /// userId of the associate owner when ownershipType = 'associate'.
  ownershipUserId      String?                @map("ownership_user_id")
  /// Set during offboarding — previous owner's userId (drives "Forwarded from" chip).
  forwardedFromUserId  String?                @map("forwarded_from_user_id")
  forwardedFromUser    User?                  @relation("ClientForwardedFrom", fields: [forwardedFromUserId], references: [id], onDelete: SetNull)
  calls                Call[]
  contacts             ClientContact[]
  locations            ClientLocation[]
  notes                ClientNote[]
  noteFieldValues      ClientNoteFieldValue[]
  remarks              Remark[]
  restrictions         ClientRestriction[]
  clientSubCompanies   ClientSubCompany[]
  tags                 ClientTag[]
  documents            Document[]
  emailRecipients      EmailRecipient[]
  emails               Email[]
  followUps            FollowUp[]
  leadRequests         LeadRequest[]
  leads                Lead[]
  meetings             Meeting[]
  mailingListMembers   MailingListClient[]
  pendingEdits            PendingClientEdit[]
  pendingImportedContacts PendingImportedContact[]
  employeeAssignments     EmployeeAssignment[]

  @@index([status])
  @@index([industry])
  @@index([location])
  @@index([corporateCode])
  @@index([lastActivity])
  @@index([updatedAt])
  @@index([visibility])
  @@index([createdAt])
  @@index([name])
  @@index([parentClientId])
  @@index([importSourceId])
  @@index([createdById])
  @@map("clients")
}


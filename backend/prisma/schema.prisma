}

model ReviewTemplate {
  id               String                 @id @default(uuid())
  name             String
  documentType     String                 @default("agreement") @map("document_type")
  documentCategory String                 @default("agreement") @map("document_category")
  originalFilename String                 @map("original_filename")
  fileKey          String                 @map("file_key")
  anchorMap        Json?                  @map("anchor_map")
  /// false = retired (replaced or deleted). Kept so proposal.reviewTemplateId history still resolves.
  isActive         Boolean                @default(true) @map("is_active")
  subCompanyId     String                 @map("sub_company_id")
  uploadedById     String                 @map("uploaded_by_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  subCompany       SubCompany             @relation(fields: [subCompanyId], references: [id])
  uploadedBy       User                   @relation("ReviewTemplateUploader", fields: [uploadedById], references: [id])
  proposals        Proposal[]
  mappingsAsTemp   ReviewTemplateMapping? @relation("TempReviewTemplate")
  mappingsAsDirect ReviewTemplateMapping? @relation("DirectReviewTemplate")
  mappingsAsBoth   ReviewTemplateMapping? @relation("BothReviewTemplate")

  @@index([subCompanyId])
  @@index([subCompanyId, documentType, isActive])
  @@map("review_templates")
}

model ReviewTemplateMapping {
  id               String          @id @default(uuid())
  subCompanyId     String          @unique @map("sub_company_id")
  tempTemplateId   String?         @unique @map("temp_template_id")
  directTemplateId String?         @unique @map("direct_template_id")
  bothTemplateId   String?         @unique @map("both_template_id")
  subCompany       SubCompany      @relation(fields: [subCompanyId], references: [id])
  tempTemplate     ReviewTemplate? @relation("TempReviewTemplate", fields: [tempTemplateId], references: [id], onDelete: SetNull)
  directTemplate   ReviewTemplate? @relation("DirectReviewTemplate", fields: [directTemplateId], references: [id], onDelete: SetNull)
  bothTemplate     ReviewTemplate? @relation("BothReviewTemplate", fields: [bothTemplateId], references: [id], onDelete: SetNull)

  @@map("review_template_mappings")
}

model UserActivityEvent {

/// Custom "Field Notes" definitions configured by super users. Visible on a client's Client Notes tab
/// once the client has a closed_won lead. visibility=global → seen by all agencies (subCompanyId NULL).
/// visibility=agency → seen only when the viewer is in subCompanyId.
model ClientNoteFieldDef {
  id           String              @id @default(uuid())
  key          String              @db.VarChar(64)
  label        String              @db.VarChar(128)
  fieldType    ClientNoteFieldType @map("field_type")
  options      Json?
  visibility   ClientVisibility    @default(global)
  subCompanyId String?             @map("sub_company_id")
  sortOrder    Int                 @default(0) @map("sort_order")
  isActive     Boolean             @default(true) @map("is_active")
  createdById  String              @map("created_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  subCompany SubCompany?            @relation(fields: [subCompanyId], references: [id], onDelete: Cascade)
  createdBy  User                   @relation("ClientNoteFieldDefCreatedBy", fields: [createdById], references: [id])
  values     ClientNoteFieldValue[]

  @@unique([subCompanyId, key])
  @@index([visibility, subCompanyId])
  @@index([isActive, sortOrder])
  @@map("client_note_field_defs")
}

/// One row per (client, fieldDef, subCompany). For global fields, all agencies share one logical row
/// keyed on (clientId, fieldDefId) enforced by service-layer transactional upsert.
model ClientNoteFieldValue {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  fieldDefId   String   @map("field_def_id")
  subCompanyId String   @map("sub_company_id")

enum PhoneQueueEntryStatus {
  waiting
  connecting
  connected
  abandoned
  timeout
}

model AgentPhonePresence {
  userId          String               @id @map("user_id")
  subCompanyId    String?              @map("sub_company_id")
  manualStatus    AgentPresenceStatus? @map("manual_status")
  activeCallCount Int                  @default(0) @map("active_call_count")
  lastCallEndedAt DateTime?            @map("last_call_ended_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([subCompanyId])
  @@map("agent_phone_presence")
}

model PhoneQueueEntry {
  id              String                @id @default(uuid())
  subCompanyId    String                @map("sub_company_id")

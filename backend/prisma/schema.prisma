  reassignedBy         User?                     @relation("LeadReassignedBy", fields: [reassignedById], references: [id])
  forwardedFromUser    User?                     @relation("LeadForwardedFrom", fields: [forwardedFromUserId], references: [id], onDelete: SetNull)
  reassignedFromLead   Lead?                     @relation("LeadReassignmentChain", fields: [reassignedFromLeadId], references: [id])
  reassignedToLeads    Lead[]                    @relation("LeadReassignmentChain")

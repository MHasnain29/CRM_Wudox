{
  "name": "wudox-crm-backend",
  "version": "1.0.0",
  "description": "Backend API for Wudox CRM - Staffing Agency Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-all": "tsx prisma/seedAll.ts",
    "prisma:seed-clean": "tsx prisma/seed-clean.ts",
    "prisma:seed-rbac": "tsx prisma/seed-rbac.ts",
    "prisma:seed-approval": "tsx prisma/seed-approval.ts",
    "prisma:seed-recruitment": "tsx prisma/seed-recruitment.ts",
    "prisma:seed-client-recruitment-demo": "tsx prisma/seed-client-recruitment-demo.ts",
    "prisma:seed-client-recruitment-dummy": "tsx prisma/seed-client-recruitment-dummy.ts",
    "prisma:backfill-phone-system": "tsx prisma/backfillPhoneSystem.ts",
    "prisma:backfill-phone-defaults": "tsx prisma/backfillPhoneDefaults.ts",
    "seed:agency-phone": "tsx scripts/seed-agency-phone-defaults.ts",
    "scripts:encrypt-secrets": "tsx scripts/encrypt-stored-secrets.ts",
    "prisma:sync-templates": "tsx prisma/update-followup-templates.ts && tsx prisma/insert-service-rate-templates.ts && tsx prisma/insert-industry-templates.ts && tsx prisma/insert-why-us-template.ts && tsx prisma/insert-welcome-onboarding-template.ts && tsx prisma/update-remaining-templates.ts",
    "db:create": "node scripts/create-database.js",
    "db:export": "node scripts/export-database.js",
    "db:import": "./scripts/import-database.sh",
    "db:reset": "prisma migrate reset --force",
    "db:sync-live": "tsx scripts/sync-live.ts",
    "scripts:clear-leads": "tsx scripts/clear-leads.ts",
    "scripts:wipe-keep-hassan": "tsx scripts/wipe-crm-keep-hassan.ts",
    "seed:filter-test": "tsx prisma/seed-filter-test.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "tunnel:sync": "tsx scripts/sync-twilio-webhook.ts"
  },
  "keywords": [
    "crm",
    "staffing",
    "api",
    "nodejs",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.999.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@prisma/client": "^5.19.1",
    "@sendgrid/mail": "^8.1.3",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.22.2",
    "cors": "^2.8.5",
    "docxtemplater": "^3.68.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.2.0",
    "googleapis": "^171.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.0",
    "wudox-crm": "file:..",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "pdfkit": "^0.18.0",
    "pg": "^8.18.0",
    "pizzip": "^3.2.0",
    "socket.io": "^4.8.3",
    "twilio": "^5.12.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.19.1",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
